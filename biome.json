{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/src/domain/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "error" },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": { "deniedGlobals": { "Bun": "domain must stay pure", "process": "domain must stay pure" } }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "domain must stay pure",
                  "node:fs/promises": "domain must stay pure",
                  "node:child_process": "domain must stay pure",
                  "node:os": "domain must stay pure",
                  "bun": "domain must stay pure"
                },
                "patterns": [{ "group": ["../*"], "message": "domain must not depend on outer layers" }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/application/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "error" },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": { "deniedGlobals": { "Bun": "application must stay pure", "process": "application must stay pure" } }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "application must stay pure",
                  "node:fs/promises": "application must stay pure",
                  "node:child_process": "application must stay pure",
                  "node:os": "application must stay pure",
                  "bun": "application must stay pure"
                },
                "patterns": [{ "group": ["../controller/*", "../infrastructure/*", "../index.ts"], "message": "application must not depend on outer layers" }]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/controller/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": { "deniedGlobals": { "Bun": "controller must go through ports", "process": "controller must go through ports" } }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "controller must go through ports",
                  "node:fs/promises": "controller must go through ports",
                  "node:child_process": "controller must go through ports",
                  "node:os": "controller must go through ports",
                  "bun": "controller must go through ports"
                },
                "patterns": [{ "group": ["../infrastructure/*", "../index.ts"], "message": "controller must not depend on outer layers" }]
              }
            }
          }
        }
      }
    }
  ],
  "files": {
    "includes": ["**/src/**/*.ts", "!**/node_modules", "!**/dist", "!**/*.d.ts"]
  }
}
